# SPDX-License-Identifier: BSD-3-Clause

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{swift,py}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.{xcconfig,pbxproj,xcscheme,xcworkspacedata,xcstrings,xcprivacy,entitlements}]
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab

[*.sh]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
