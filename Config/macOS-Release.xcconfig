#include "Release.xcconfig"

PRODUCT_NAME = GlifiStudio
PRODUCT_MODULE_NAME = GlifiStudio_macOS
PRODUCT_BUNDLE_IDENTIFIER = studio.glifi.GlifiStudio
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

SDKROOT = macosx
SUPPORTED_PLATFORMS = macosx
MACOSX_DEPLOYMENT_TARGET = 27.0
CODE_SIGN_STYLE = Automatic
CODE_SIGN_ENTITLEMENTS = Config/GlifiStudio-macOS.entitlements
ENABLE_APP_SANDBOX = YES
ENABLE_HARDENED_RUNTIME = YES
INFOPLIST_KEY_CFBundleDisplayName = Glifi Studio
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_LSApplicationSupportsSecureRestorableState = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks
